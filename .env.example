# Copia este archivo como ".env" y completa los valores (el archivo .env NO se sube a GitHub)
DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos local (PostgreSQL)
DB_NAME=sagp_app
DB_USER=postgres
DB_PASSWORD=TU_CLAVE_DE_POSTGRES
DB_HOST=localhost
DB_PORT=5432

# En producción (DigitalOcean) se usa solo esta variable y reemplaza a las DB_*:
# DATABASE_URL=postgresql://usuario:clave@host:puerto/base?sslmode=require
